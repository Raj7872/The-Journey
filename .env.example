# ─────────────────────────────────────────────────────
# The Last Train Home — Environment Variables
# Copy this file to .env.local for local development
# Never commit .env.local to version control
# ─────────────────────────────────────────────────────

# Application
# -----------
# The recipient's name — used in the proposal screen
# This is the only personalization required
NEXT_PUBLIC_RECIPIENT_NAME="Her Name"

# Debug / Development
# --------------------
# Set to 'true' to enable scene jump shortcuts (dev only)
NEXT_PUBLIC_DEBUG_SCENES=false

# Set to 'true' to skip the preloader (dev only)
NEXT_PUBLIC_SKIP_PRELOADER=false

# Set to 'true' to show verbose system logs (dev only)
NEXT_PUBLIC_VERBOSE_LOGGING=false

# Set to 'true' to start from the proposal directly (dev only)
NEXT_PUBLIC_START_AT_PROPOSAL=false

# Asset Configuration
# --------------------
# Override base path for assets (useful for CDN deployment)
# Leave empty to use default /public serving
NEXT_PUBLIC_ASSET_BASE_URL=""

# Audio Configuration
# --------------------
# Global audio enabled by default
NEXT_PUBLIC_AUDIO_ENABLED=true

# Feature Flags
# --------------
# Enable WebGL atmospheric effects (R3F canvas)
# Can be disabled for lower-end devices
NEXT_PUBLIC_ENABLE_WEBGL=true

# Enable custom cursor
NEXT_PUBLIC_ENABLE_CUSTOM_CURSOR=true

# Cloudflare Pages
# -----------------
# These are automatically set by Cloudflare — do not set manually
# CF_PAGES_URL=
# CF_PAGES_BRANCH=
# CF_PAGES_COMMIT_SHA=
